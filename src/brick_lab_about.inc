static const char *lab_about(int p)
{
    const char *any = 0;
    for (size_t i = 0; i < sizeof LAB_ABOUT / sizeof LAB_ABOUT[0]; i++) {
        if (LAB_ABOUT[i].mod == M_SENDS && LAB_P[p].mod == M_SENDS && strchr(LAB_P[p].name, '>'))
            return LAB_ABOUT[i].about;
        if (strcmp(LAB_ABOUT[i].name, LAB_P[p].name))
            continue;
        if (LAB_ABOUT[i].mod == LAB_P[p].mod)
            return LAB_ABOUT[i].about;
        if (LAB_ABOUT[i].mod < 0 && !any)
            any = LAB_ABOUT[i].about;
    }
    return any;
}
